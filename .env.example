# Telegram Bot API
# Create a bot via @BotFather on Telegram, then /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your Telegram chat ID — send /start to @userinfobot to find it
# Positive integer for personal chat; negative integer for group chat
TELEGRAM_CHAT_ID=987654321

# OpenRouter API key for condition classification
# Sign up at https://openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-...

# OpenRouter base URL (default is correct — only change if using a self-hosted proxy)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional overrides
# DB_PATH=seen_listings.db
# LOG_DIR=logs
